page{background:#f6f5f2;color:#242424;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{padding:36rpx}.card{background:#fff;border-radius:28rpx;padding:36rpx;margin-bottom:24rpx;box-shadow:0 8rpx 30rpx rgba(0,0,0,.04)}.title{font-size:52rpx;font-weight:700;line-height:1.25}.subtitle{font-size:30rpx;color:#777;line-height:1.7;margin:18rpx 0}.btn{background:#292621;color:#fff;border-radius:999rpx;margin-top:28rpx}.btn.secondary{background:#e9e5dd;color:#292621}.btn.ghost{background:transparent;color:#555;border:1rpx solid #bbb}.loading,.empty,.error{text-align:center;color:#777;padding:80rpx 20rpx}.tag{display:inline-block;padding:10rpx 18rpx;background:#f0ede7;border-radius:999rpx;margin:8rpx}.score{display:flex;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #eee}.progress{height:12rpx;background:#e5e1d9;border-radius:999rpx;overflow:hidden}.progress-inner{height:100%;background:#725b3f}.option{background:#fff;border:2rpx solid transparent;border-radius:22rpx;padding:28rpx;margin:20rpx 0}.option.selected{border-color:#725b3f;background:#f5efe7}
