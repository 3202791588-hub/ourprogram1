<view class="page"><view wx:if="{{loading}}" class="loading">加载历史…</view><view wx:elif="{{error}}" class="error">{{error}}<button class="btn" bindtap="load">重试</button></view><block wx:else><view class="title">人格测试</view><view wx:if="{{!results.length}}" class="empty">暂无记录</view><view wx:for="{{results}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openResult"><view>{{item.name}}</view><view class="subtitle">{{item.summary}}</view></view><view class="title">好友关系</view><view wx:if="{{!relationships.length}}" class="empty">暂无关系报告</view><view wx:for="{{relationships}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openRelation"><view>{{item.report_payload.name}}</view><view class="subtitle">相处适配度 {{item.compatibility_score}}</view></view></block></view>
