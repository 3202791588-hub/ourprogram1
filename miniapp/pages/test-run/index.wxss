page{height:100%;overflow:hidden;background:#e9eee7}
.journey-page{position:relative;width:100%;height:100vh;overflow:hidden;color:#293b35;background:linear-gradient(180deg,#9caaa6 0%,#e9e5d7 52%,#f5efdf 100%)}
.scene-image{position:absolute;inset:0;width:100%;height:100%;animation:scene-arrive 420ms ease-out both}
.scene-preload{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
.paper-wash{position:absolute;inset:34% 0 0;background:linear-gradient(180deg,rgba(247,241,224,0) 0%,rgba(247,241,224,.28) 11%,rgba(247,241,224,.7) 27%,rgba(247,241,224,.9) 52%,rgba(247,241,224,.96) 100%);pointer-events:none}
.scene-fallback .paper-wash{inset:0;background:linear-gradient(180deg,rgba(123,146,142,.88),#f3eddc 52%,#f7f1e4)}
.top-safe{position:absolute;z-index:4;top:0;right:0;left:0;padding-right:30rpx;padding-left:30rpx;color:#f8f3e7;text-shadow:0 2rpx 10rpx rgba(25,40,37,.42)}
.journey-nav{display:flex;align-items:center;height:68rpx}.back-button{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;margin-right:8rpx;font-family:Georgia,serif;font-size:54rpx;line-height:1}.chapter-name{flex:1;font-size:25rpx;letter-spacing:4rpx}.question-count{font-size:24rpx;letter-spacing:2rpx}
.moon-progress{height:4rpx;margin:6rpx 4rpx 0 66rpx;overflow:hidden;border-radius:999rpx;background:rgba(255,252,242,.28)}.moon-progress-inner{height:100%;border-radius:inherit;background:#f1b49b;box-shadow:0 0 12rpx rgba(241,180,155,.55);transition:width 260ms ease-out}
.question-scroll{position:absolute;z-index:2;inset:0;width:100%;height:100%}.scene-spacer{height:47vh;min-height:600rpx}.question-stage{min-height:53vh;padding:24rpx 42rpx calc(env(safe-area-inset-bottom) + 34rpx);transform-origin:center top}.question-stage.entering{animation:question-arrive 250ms ease-out both}.question-stage.completing{animation:question-confirm 320ms ease-out both}
.story-kicker{margin-bottom:14rpx;color:#50665e;font-size:23rpx;letter-spacing:2rpx;text-shadow:0 1rpx 2rpx rgba(255,250,237,.7)}.story-question{max-width:650rpx;margin-bottom:24rpx;color:#263a34;font-family:"Songti SC","STSong",serif;font-size:36rpx;font-weight:600;line-height:1.46;letter-spacing:.5rpx;text-shadow:0 1rpx 0 rgba(255,255,255,.45)}
.branch-list{position:relative;padding:2rpx 0 4rpx}.path-option{position:relative;display:flex;align-items:center;box-sizing:border-box;width:91%;min-height:78rpx;margin:4rpx 0;padding:12rpx 22rpx 12rpx 48rpx;color:#394c45;font-size:29rpx;line-height:1.42;transition:color 180ms ease,transform 180ms ease,opacity 180ms ease}.path-0,.path-2{margin-right:auto;transform:translateX(-2rpx)}.path-1,.path-3{margin-left:auto;transform:translateX(12rpx)}.right-left-staggered .path-0,.right-left-staggered .path-2{margin-right:0;margin-left:auto;transform:translateX(9rpx)}.right-left-staggered .path-1,.right-left-staggered .path-3{margin-right:auto;margin-left:0;transform:translateX(-5rpx)}
.branch-line{position:absolute;top:50%;left:8rpx;width:28rpx;height:1rpx;background:linear-gradient(90deg,rgba(92,112,102,.08),rgba(92,112,102,.52));transform:rotate(-8deg);transform-origin:right center}.path-1 .branch-line,.path-3 .branch-line{transform:rotate(9deg)}.path-dot{position:absolute;left:36rpx;width:8rpx;height:8rpx;border:1rpx solid rgba(76,100,90,.48);border-radius:50%;background:rgba(247,241,224,.68)}.option-copy{position:relative;z-index:1;padding-bottom:5rpx;border-bottom:1rpx solid rgba(91,112,102,.13)}
.path-option.locked:not(.selected){opacity:.45}.path-option.selected{color:#bd6f59;font-weight:600;transform:translateX(18rpx)}.path-option.selected .path-dot{border-color:#cf846d;background:#cf846d;box-shadow:0 0 12rpx rgba(207,132,109,.35)}.path-option.selected .branch-line{background:linear-gradient(90deg,rgba(207,132,109,.08),#cf846d)}
.selected-trail{display:flex;align-items:center;margin-left:12rpx;color:#c6755e;font-size:18rpx;letter-spacing:2rpx;white-space:nowrap}.selected-trail text{opacity:0;animation:paw-arrive 220ms ease-out forwards}.selected-trail text:nth-child(2){animation-delay:55ms}.selected-trail text:nth-child(3){animation-delay:110ms}.selected-trail text:nth-child(4){animation-delay:165ms;font-size:27rpx}.answer-confirm{height:42rpx;color:#b56d57;font-size:24rpx;letter-spacing:2rpx;text-align:center;animation:confirm-in 220ms ease-out both}
.page-actions{display:flex;align-items:center;justify-content:center;min-height:74rpx;margin-top:4rpx}.previous-button,.submit-button,.retry-button{min-height:64rpx;margin:0;padding:0 28rpx;border:0;border-radius:999rpx;font-size:26rpx;line-height:64rpx}.previous-button{color:#63746d;background:transparent}.previous-button::after,.submit-button::after,.retry-button::after{border:0}.previous-button[disabled]{opacity:.25}.submit-button{margin-left:16rpx;color:#fff9ee;background:#bf755e;box-shadow:0 8rpx 24rpx rgba(135,85,67,.18)}.submit-button[disabled]{opacity:.38}.save-tip{min-height:32rpx;color:rgba(65,84,76,.62);font-size:22rpx;text-align:center}
.state-panel{position:absolute;z-index:8;top:43%;right:56rpx;left:56rpx;padding:38rpx;color:#3c5149;font-size:29rpx;text-align:center;border-radius:24rpx;background:rgba(248,242,226,.84)}.retry-button{display:inline-block;margin-top:24rpx;color:#fff9ee;background:#6d8279}
.result-transition{position:absolute;z-index:12;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 64rpx;color:#34483d;text-align:center;background:rgba(242,235,215,.82);backdrop-filter:blur(24rpx);animation:transition-in 280ms ease-out both}.transition-moon{width:128rpx;height:128rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(74,99,82,.28);border-radius:50%;animation:moon-orbit 2.4s linear infinite}.transition-moon::before{content:"";position:absolute;width:90rpx;height:90rpx;border:1rpx dashed rgba(74,99,82,.25);border-radius:50%}.transition-moon view{width:42rpx;height:42rpx;border-radius:50%;background:#607b68;box-shadow:0 0 46rpx rgba(76,104,84,.35)}.transition-title{margin-top:38rpx;font-family:"Songti SC","STSong",serif;font-size:38rpx;font-weight:600;letter-spacing:2rpx}.transition-copy{margin-top:16rpx;color:#718078;font-size:23rpx;line-height:1.7}
@keyframes scene-arrive{from{opacity:.25;transform:scale(1.015)}to{opacity:1;transform:scale(1)}}@keyframes question-arrive{from{opacity:0;transform:translateY(14rpx)}to{opacity:1;transform:translateY(0)}}@keyframes question-confirm{0%{transform:scale(1)}50%{transform:scale(.994)}100%{transform:scale(1)}}@keyframes paw-arrive{from{opacity:0;transform:translateX(-6rpx) scale(.6)}to{opacity:1;transform:translateX(0) scale(1)}}@keyframes confirm-in{from{opacity:0;transform:translateY(8rpx)}to{opacity:1;transform:translateY(0)}}@keyframes transition-in{from{opacity:0}to{opacity:1}}@keyframes moon-orbit{to{transform:rotate(360deg)}}
