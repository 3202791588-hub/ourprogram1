<view class="page"><view wx:if="{{loading}}" class="loading">生成关系报告…</view><view wx:elif="{{error}}" class="error">{{error}}<button class="btn" bindtap="load">重试</button></view><view wx:else><view class="card"><view class="subtitle">你们是</view><view class="title">「{{report.report_payload.name}}」</view><view class="subtitle">{{report.report_payload.summary}}</view><view class="title">相处适配度 {{report.compatibility_score}}</view></view><view class="card"><view wx:for="{{scores}}" wx:key="label" class="score"><text>{{item.label}}</text><text>{{item.value}}</text></view><button class="btn" open-type="share">分享关系结果</button></view></view></view>
