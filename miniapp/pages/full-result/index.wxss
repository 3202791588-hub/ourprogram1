page{background:#263b35}.journal-page{position:relative;min-height:100vh;overflow:hidden;color:#f5f0df;background:linear-gradient(180deg,#263b35 0%,#496055 37%,#ddd5bd 78%,#eee7d5 100%)}
.sky-glow{position:absolute;top:-100rpx;right:-120rpx;width:520rpx;height:520rpx;border-radius:50%;background:radial-gradient(circle,rgba(236,226,186,.2),transparent 65%)}.moon{position:absolute;top:180rpx;right:82rpx;width:116rpx;height:116rpx;border-radius:50%;background:#eee6c9;box-shadow:0 0 60rpx rgba(237,227,190,.25)}.star{position:absolute;color:rgba(244,237,212,.65)}.star-one{top:270rpx;left:84rpx;font-size:24rpx}.star-two{top:360rpx;right:230rpx;font-size:42rpx}
.journal-nav{position:absolute;z-index:4;top:0;right:0;left:0;display:flex;align-items:center;justify-content:space-between;padding-left:30rpx;padding-right:30rpx;font-size:24rpx;letter-spacing:5rpx}.back{width:58rpx;height:58rpx;display:flex;align-items:center;justify-content:center;font-family:serif;font-size:54rpx}.nav-dot{width:58rpx;text-align:center;font-size:20rpx}
.journal-scroll{position:relative;z-index:2;height:100vh}.journal-hero{padding:340rpx 44rpx 70rpx}.journal-kicker{color:rgba(244,239,220,.68);font-size:18rpx;letter-spacing:5rpx}.journal-title{margin-top:16rpx;font-family:"Songti SC","STSong",serif;font-size:52rpx;font-weight:600;letter-spacing:3rpx}.journal-summary{width:84%;margin-top:19rpx;color:rgba(248,243,226,.78);font-size:25rpx;line-height:1.75}
.spectrum-card,.journal-card{margin:0 30rpx 22rpx;border:1rpx solid rgba(255,255,255,.44);border-radius:32rpx;background:rgba(249,246,235,.72);box-shadow:0 18rpx 46rpx rgba(38,49,42,.1);color:#405047;backdrop-filter:blur(24rpx)}.spectrum-card{padding:32rpx}.card-title{font-family:"Songti SC","STSong",serif;color:#34473c;font-size:31rpx;font-weight:600;letter-spacing:2rpx}.mini-score{padding-top:26rpx}.mini-score-head{display:flex;justify-content:space-between;color:#617067;font-size:22rpx}.mini-track{height:7rpx;margin-top:13rpx;border-radius:999rpx;background:rgba(74,96,81,.12)}.mini-track view{height:100%;border-radius:inherit;background:linear-gradient(90deg,#9caa9c,#536d5c)}
.journal-card{display:flex;padding:34rpx 30rpx}.chapter-index{width:72rpx;color:#9aa499;font-family:serif;font-size:25rpx;letter-spacing:2rpx}.chapter-copy{flex:1}.card-content{margin-top:17rpx;color:#68756d;font-size:27rpx;line-height:1.85}
.journal-footer{padding:40rpx 65rpx calc(env(safe-area-inset-bottom) + 60rpx);text-align:center;color:#68756d}.journal-footer>text{font-size:36rpx}.journal-footer view{margin-top:15rpx;font-family:"Songti SC","STSong",serif;font-size:25rpx;line-height:1.75}.journal-footer .footer-note{margin-top:17rpx;color:#9a9d95;font-family:inherit;font-size:18rpx}
.journal-state,.unlock-card{position:relative;z-index:3;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 58rpx;text-align:center}.journal-state{gap:24rpx;color:#e8e2cf;font-size:25rpx}.small-moon{width:54rpx;height:54rpx;border-radius:50%;background:#e7dfc2;box-shadow:0 0 40rpx rgba(237,226,186,.28);animation:pulse 1.5s ease-in-out infinite}.unlock-card{margin:0 34rpx;color:#f2edda}.lock-glyph{width:130rpx;height:130rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(248,240,215,.24);border-radius:50%;font-size:58rpx}.unlock-kicker{margin-top:32rpx;color:rgba(242,236,216,.62);font-size:18rpx;letter-spacing:5rpx}.unlock-title{margin-top:18rpx;font-family:"Songti SC","STSong",serif;font-size:42rpx;line-height:1.45}.unlock-copy{margin-top:20rpx;color:rgba(241,236,219,.72);font-size:25rpx;line-height:1.75}.unlock-button{width:100%;height:92rpx;margin-top:38rpx;border-radius:999rpx;background:#ece5cf;color:#34483c;font-size:27rpx;font-weight:600}.unlock-button::after{border:0}.unlock-note{margin-top:20rpx;color:rgba(241,236,219,.46);font-size:18rpx;line-height:1.6}
@keyframes pulse{50%{transform:scale(.88);opacity:.65}}
