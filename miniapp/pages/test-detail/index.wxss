page{height:100%;overflow:hidden;background:#18241f}
.detail-page{position:relative;width:100vw;height:100vh;overflow:hidden;color:#2d4137;background:#18241f}
.detail-scene{position:absolute;z-index:0;inset:0;width:100%;height:100%}
.detail-shade{position:absolute;z-index:1;inset:0;background:linear-gradient(180deg,rgba(13,24,20,.28) 0%,rgba(24,37,31,.05) 38%,rgba(237,234,215,.18) 57%,rgba(237,234,215,.72) 76%,rgba(237,234,215,.9) 100%)}
.detail-nav{position:absolute;z-index:4;top:0;right:0;left:0;display:flex;align-items:center;height:72rpx;padding-right:36rpx;padding-left:28rpx;color:#f5eed7;text-shadow:0 2rpx 12rpx rgba(8,16,13,.58)}
.back-button{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-size:56rpx;line-height:1}
.nav-title{font-size:24rpx;letter-spacing:5rpx}
.detail-content{position:absolute;z-index:3;right:34rpx;bottom:calc(32rpx + env(safe-area-inset-bottom));left:34rpx;box-sizing:border-box;padding:38rpx 38rpx 34rpx;border-radius:42rpx;background:rgba(245,241,222,.74);box-shadow:0 18rpx 60rpx rgba(19,32,26,.17);backdrop-filter:blur(20rpx)}
.detail-kicker{color:#6f7c71;font-size:20rpx;letter-spacing:3rpx;text-align:center}
.detail-title{margin-top:16rpx;color:#284035;font-family:"Songti SC","STSong",serif;font-size:54rpx;font-weight:600;line-height:1.25;letter-spacing:3rpx;text-align:center}
.detail-description{max-width:610rpx;margin:18rpx auto 0;color:#526158;font-size:25rpx;line-height:1.72;text-align:center}
.journey-facts{display:flex;align-items:center;justify-content:center;margin:28rpx 0 30rpx;padding:20rpx 4rpx;border-top:1rpx solid rgba(73,92,81,.12);border-bottom:1rpx solid rgba(73,92,81,.12)}
.fact{flex:1;display:flex;flex-direction:column;align-items:center;min-width:0}
.fact-value{color:#344b3f;font-family:"Songti SC","STSong",serif;font-size:29rpx;font-weight:600}
.fact-label{margin-top:7rpx;color:#718078;font-size:18rpx;letter-spacing:1rpx}
.fact-divider{width:1rpx;height:46rpx;background:rgba(70,92,80,.16)}
button::after{border:0}
.journey-button{position:relative;display:flex;align-items:center;justify-content:center;width:100%;height:92rpx;margin:0;border:1rpx solid rgba(255,251,230,.68);border-radius:999rpx;background:rgba(250,245,220,.9);box-shadow:0 10rpx 30rpx rgba(50,55,40,.14),inset 0 1rpx rgba(255,255,255,.84);color:#30463a;font-family:"Songti SC","STSong",serif;font-size:29rpx;font-weight:600;letter-spacing:4rpx}
.journey-button:active{transform:scale(.985);background:rgba(255,250,230,.96)}
.button-arrow{position:absolute;right:34rpx;top:18rpx;color:#6d7a6f;font-family:Arial,sans-serif;font-size:48rpx;font-weight:300;line-height:1}
.detail-note{margin-top:17rpx;color:#7a857d;font-size:19rpx;letter-spacing:1rpx;text-align:center}
.detail-state{position:absolute;z-index:5;top:46%;right:58rpx;left:58rpx;display:flex;flex-direction:column;align-items:center;gap:20rpx;padding:42rpx;color:#42564c;font-size:24rpx;text-align:center;border-radius:34rpx;background:rgba(245,241,223,.78);backdrop-filter:blur(18rpx)}
.error-state{color:#7f5a53}
.compact{height:76rpx;margin-top:8rpx;font-size:25rpx}
.moon-loader{width:36rpx;height:36rpx;border:4rpx solid rgba(54,77,65,.14);border-top-color:#536b5c;border-radius:50%;animation:turn .8s linear infinite}
@keyframes turn{to{transform:rotate(360deg)}}
