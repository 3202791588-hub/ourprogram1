page{background:#dcd6c4}
.result-page{position:relative;min-height:100vh;color:#2d3832;overflow:hidden}
.result-scene{position:absolute;inset:0;width:100%;height:100%;z-index:0}
.result-wash{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(246,239,217,.02) 0%,rgba(238,230,205,.18) 32%,rgba(240,233,214,.9) 59%,#eee7d3 100%)}
.result-nav{position:absolute;left:0;right:0;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;padding-left:30rpx;padding-right:30rpx;color:#f8f3e6;text-shadow:0 2rpx 14rpx rgba(34,48,40,.28)}
.nav-button{width:62rpx;height:62rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(255,255,255,.46);border-radius:50%;background:rgba(52,68,57,.15);font-size:27rpx;backdrop-filter:blur(12rpx)}
.nav-title{font-size:24rpx;font-weight:600;letter-spacing:5rpx}.nav-star{width:62rpx;text-align:center;font-size:25rpx}
.result-scroll{position:relative;z-index:2;height:100vh}
.result-spacer{height:510rpx}
.result-sheet{position:relative;min-height:800rpx;padding:118rpx 34rpx 0;border-radius:60rpx 60rpx 0 0;background:rgba(249,245,232,.84);box-shadow:0 -22rpx 70rpx rgba(56,61,48,.13),inset 0 1rpx rgba(255,255,255,.8);backdrop-filter:blur(28rpx)}
.animal-seal{position:absolute;left:50%;top:-82rpx;width:164rpx;height:164rpx;transform:translateX(-50%);display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(251,248,237,.92);box-shadow:0 15rpx 42rpx rgba(51,64,55,.16)}
.seal-orbit{position:absolute;border:1rpx solid rgba(90,108,94,.25);border-radius:50%}.orbit-one{inset:13rpx}.orbit-two{inset:27rpx;border-style:dashed}.animal-glyph{font-size:61rpx;color:#50675a}
.result-kicker{text-align:center;color:#899488;font-size:18rpx;font-weight:600;letter-spacing:4rpx}
.result-label{text-align:center;margin-top:18rpx;color:#69766d;font-size:25rpx}.result-name{text-align:center;margin-top:7rpx;font-family:"Songti SC","STSong",serif;color:#2d3d34;font-size:54rpx;font-weight:600;letter-spacing:3rpx}.result-caption{text-align:center;margin-top:14rpx;color:#728076;font-size:23rpx}
.tag-row{display:flex;justify-content:center;flex-wrap:wrap;gap:13rpx;margin-top:25rpx}.result-tag{padding:10rpx 23rpx;border:1rpx solid rgba(79,101,86,.18);border-radius:999rpx;background:rgba(255,255,255,.42);color:#607067;font-size:22rpx}
.summary-card{position:relative;margin-top:31rpx;padding:34rpx 32rpx 30rpx;border:1rpx solid rgba(255,255,255,.62);border-radius:30rpx;background:rgba(255,255,255,.4);color:#526158;font-size:27rpx;line-height:1.8;box-shadow:inset 0 1rpx rgba(255,255,255,.55)}
.quote-mark{position:absolute;right:24rpx;top:3rpx;color:rgba(92,111,97,.13);font-family:serif;font-size:90rpx;line-height:1}
.section-heading{display:flex;align-items:flex-start;gap:17rpx;margin:44rpx 8rpx 22rpx;color:#3e5146}.section-heading text{display:block;font-size:31rpx;font-weight:600}.section-heading .section-note{margin-top:8rpx;color:#879087;font-size:20rpx;font-weight:400}.section-star{padding-top:4rpx;color:#8d9c8e;font-size:25rpx}
.score-card{padding:15rpx 28rpx 10rpx;border:1rpx solid rgba(255,255,255,.58);border-radius:32rpx;background:rgba(255,255,255,.36)}
.score-item{padding:25rpx 0}.score-head{display:flex;align-items:flex-start;justify-content:space-between}.score-label,.score-hint{display:block}.score-label{color:#405147;font-size:26rpx;font-weight:600}.score-hint{margin-top:5rpx;color:#8a928c;font-size:19rpx}.score-value{font-family:serif;color:#596f61;font-size:30rpx}
.score-track{position:relative;height:8rpx;margin-top:19rpx;border-radius:999rpx;background:rgba(81,104,88,.12)}.score-fill{height:100%;border-radius:999rpx;background:linear-gradient(90deg,#abb9aa,#506b59)}.score-moon{position:absolute;top:50%;transform:translate(-50%,-55%);color:#f4efe0;font-size:23rpx;text-shadow:0 1rpx 8rpx rgba(45,63,52,.35)}
.mock-note{margin:25rpx 18rpx 31rpx;text-align:center;color:#93978e;font-size:19rpx;line-height:1.6}
button::after{border:0}.primary-button{display:flex;align-items:center;justify-content:center;gap:70rpx;width:100%;height:94rpx;margin:0;border-radius:999rpx;background:linear-gradient(135deg,#42584b,#273b31);box-shadow:0 14rpx 34rpx rgba(45,62,51,.18);color:#faf6e9;font-size:28rpx;font-weight:600;letter-spacing:2rpx}.secondary-actions{display:flex;gap:16rpx;margin-top:17rpx}.soft-button{flex:1;height:78rpx;margin:0;border:1rpx solid rgba(74,94,81,.16);border-radius:999rpx;background:rgba(255,255,255,.35);color:#647168;font-size:22rpx}.invite-note{margin-top:18rpx;text-align:center;color:#77837a;font-size:21rpx}.bottom-space{height:70rpx}
.result-state{position:relative;z-index:3;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 56rpx;background:rgba(239,232,211,.55);backdrop-filter:blur(12rpx);text-align:center}.orbit-loader{width:100rpx;height:100rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(73,95,80,.32);border-radius:50%;animation:turn 2.2s linear infinite}.orbit-loader view{width:36rpx;height:36rpx;border-radius:50%;background:#617868;box-shadow:0 0 36rpx rgba(75,100,82,.3)}.state-title{margin-top:30rpx;font-family:"Songti SC","STSong",serif;color:#34473b;font-size:38rpx}.state-copy{margin:16rpx 0 34rpx;color:#768179;font-size:24rpx;line-height:1.7}.error-state{background:rgba(241,233,214,.82)}
@keyframes turn{to{transform:rotate(360deg)}}
